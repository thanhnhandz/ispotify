<div class="container-box-content1">
    <!-- Những bài hát thịnh hành -->
    <div class="container-box-component">
        <div class="container-box-component--header">
            <div class="container-box-component--header--div">
                <span class="container-box-component--header--text">Những bài hát thịnh hành</span>
                <span class="container-box-component--header--showAll">Hiện tất cả</span>
            </div>
            <div class="slider-container">
                <button class="container-box-component--header--list--btn-left">&#10094;</button>
                <ul class="container-box-component--header--list">

                    <li class="container-box-component--header--item">
                        <a href="/song" class="container-box-component--header--item-link">
                            <div class="song-thumbnail">
                                <img src="/img/imgSong.jpg" alt="" class="container-box-component--header--item--img" />
                                <span class="container-box-component--header--item--icon-play">
                                    <i class="fa-solid fa-play"></i>
                                </span>
                            </div>
                            <span class="container-box-component--header--item--nameSong">Nằm Bên Anh</span>
                            <span class="container-box-component--header--item--artist">Minh Đinh, Hà An
                                Huy</span>
