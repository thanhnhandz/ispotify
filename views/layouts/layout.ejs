      <div class="container-box-userPage-modal-header">Chi tiết hồ sơ</div>
      <div class="container-box-userPage-avatar">
        <i class="fa-solid fa-user"></i>
        <div class="avatar-overlay">
          <span class="avatar-action choose">Chọn ảnh</span>
          <i class="fa-solid fa-pen"></i>
          <span class="avatar-action delete">Xóa ảnh</span>
        </div>
      </div>
      <input type="text" placeholder="Nhân" />
      <button id="userPageSaveBtn">Lưu</button>
      <p>Bằng cách tiếp tục, bạn đồng ý cho phép Spotify truy cập vào hình ảnh bạn đã chọn để tải lên. Vui lòng
        đảm bảo bạn có quyền tải lên hình ảnh.</p>
    </div>
  </div>
  <!-- Menu nổi chỉnh sửa bài hát -->
  <div id="menuSettingSong" class="menuSettingSong-artist-user" style="display: none;">
    <div class="menuSettingSong-artist-user-item menu-edit-song">
      <i class="fas fa-edit"></i> Chỉnh sửa
    </div>
    <div class="menuSettingSong-artist-user-item">
      <i class="fas fa-trash-alt"></i> Xóa
    </div>
    <div class="menuSettingSong-artist-user-item hasAlbumBox" onclick="toggleAlbumSelect(event)">
      <i class="fas fa-plus-square"></i> Thêm vào Album

      <div id="albumSelectBox" class="menuSettingSong-artist-user-albumSelect" style="display: none;"
        onclick="event.stopPropagation()">
        <h4>Chọn Album</h4>
        <ul>
          <li><input type="radio" name="no-album" value="0"> None</li>
          <li><input type="radio" name="album" value="1"> 1989</li>
          <li><input type="radio" name="album" value="2"> Reputation</li>
          <li><input type="radio" name="album" value="3"> Midnights</li>
        </ul>
        <button onclick="confirmAddToAlbum(event)">Xác nhận</button>
        <button onclick="cancelAddToAlbum(event)">Hủy</button>
      </div>
    </div>

  </div>
  <!-- Menu nổi chỉnh sửa album -->
  <div id="menuSettingAlbum" class="menuSettingAlbum-artist-user" style="display: none;">
    <div class="menuSettingAlbum-artist-user-item menu-edit-album">
      <i class="fas fa-edit"></i> Chỉnh sửa
    </div>
    <div class="menuSettingAlbum-artist-user-item">
      <i class="fas fa-trash-alt"></i> Xóa
    </div>
  </div>
  <!-- box thêm bài hát mới -->
  <div class="box-addNewSong-overlay" id="addNewSongOverlay">
    <div class="box-addNewSong-form">
      <button class="box-addNewSong-close" onclick="toggleAddNewSong()">✖</button>
      <h2 class="box-addNewSong-title">Thêm bài hát mới</h2>

      <!-- Ảnh bài hát -->
      <label class="box-addNewSong-label">Ảnh bài hát:</label>
      <input type="file" accept="image/*" class="box-addNewSong-input box-addNewSong-image" />

      <!-- Tên bài hát -->
      <label class="box-addNewSong-label">Tên bài hát:</label>
      <input type="text" placeholder="Nhập tên bài hát" class="box-addNewSong-input box-addNewSong-titleInput" />

      <!-- Danh sách tác giả -->
      <div class="box-addNewSong-authors">
        <label class="box-addNewSong-label">Tác giả:</label>
        <div id="box-addNewSong-authorList">
          <input type="text" name="author[]" placeholder="Nhập tên tác giả"
            class="box-addNewSong-input box-addNewSong-author" />
        </div>
        <button type="button" onclick="addNewAuthor()" class="box-addNewSong-button box-addNewSong-addAuthor">+
          Thêm
          tác
          giả</button>
      </div>

      <!-- Chọn album -->
      <label class="box-addNewSong-label">Chọn album:</label>
      <select class="box-addNewSong-input box-addNewSong-select">
        <option value="">-- Chọn album --</option>
        <option value="album1">Album 1</option>
        <option value="album2">Album 2</option>
        <option value="album3">Album 3</option>
      </select>

      <!-- Lời bài hát -->
      <label class="box-addNewSong-label">Lời bài hát:</label>
      <textarea rows="5" placeholder="Nhập lời bài hát..."
        class="box-addNewSong-input box-addNewSong-lyrics"></textarea>

      <!-- Submit -->
      <button type="submit" class="box-addNewSong-button box-addNewSong-submit">🎵 Xác nhận thêm bài hát</button>
    </div>
  </div>
  <!-- box thêm album mới -->
  <div class="box-addNewAlbum-overlay" id="addNewAlbumOverlay">
    <!-- Album Form -->
    <div class="box-addNewAlbum-form">
      <button class="box-addNewAlbum-close" onclick="toggleAddNewAlbum()">&#x2716;</button>
      <h2 class="box-addNewAlbum-title">Thêm album mới</h2>

      <!-- Ảnh album -->
      <label class="box-addNewAlbum-label">Ảnh album:</label>
      <input type="file" accept="image/*" class="box-addNewAlbum-input box-addNewAlbum-image" />

      <!-- Tên album -->
      <label class="box-addNewAlbum-label">Tên album:</label>
      <input type="text" placeholder="Nhập tên album" class="box-addNewAlbum-input box-addNewAlbum-titleInput" />

      <!-- Danh sách bài hát -->
      <label class="box-addNewAlbum-label">Chọn bài hát:</label>
      <div class="box-addNewAlbum-songList">
        <label><input type="checkbox" name="albumSongs" value="song1" /> Hết thương cạn nhớ</label>
        <label><input type="checkbox" name="albumSongs" value="song2" /> Lạc trôi</label>
        <label><input type="checkbox" name="albumSongs" value="song3" /> Chúng ta của hiện tại</label>
        <!-- Thêm bài hát ở đây -->
      </div>

      <!-- Submit -->
      <button type="submit" class="box-addNewAlbum-button box-addNewAlbum-submit">📁 Xác nhận thêm album</button>
    </div>
  </div>

  <!-- Script dùng chung -->
  <script src="/js/homepageNoLogin.js"></script>
  <script src="/js/homepageLogin.js"></script>
  <script src="/js/artistdetail.js"></script>
  <script src="/js/playlistpage.js"></script>
  <script src="/js/songdetail.js"></script>
  <script src="/js/userdetail.js"></script>
  <script src="/js/userArtistPage.js"></script>
</body>

</html>