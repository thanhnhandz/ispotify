<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- CSS dùng chung -->
  <link rel="stylesheet" href="/css/adminCss/AArtistpage.css" />
  <link rel="stylesheet" href="/css/adminCss/AChangePass.css" />
  <link rel="stylesheet" href="/css/adminCss/ACreateNewAdmin.css" />
  <link rel="stylesheet" href="/css/adminCss/ADashboard.css" />
  <link rel="stylesheet" href="/css/adminCss/AProfile.css" />
  <link rel="stylesheet" href="/css/adminCss/AReportpage.css" />
  <link rel="stylesheet" href="/css/adminCss/ASongpage.css" />
  <link rel="stylesheet" href="/css/adminCss/AUserpage.css" />
  <link rel="stylesheet" href="/css/adminCss/userdetail.css" />
  <link rel="stylesheet" href="/css/adminCss/sidebar.css" />
  <link rel="stylesheet" href="/assets/font/fontawesome-free-6.5.1-web/css/all.min.css" />

  <title>
    <%= title || "Trang chủ" %>
  </title>
</head>

<body>
    <div class="AHomepage-box AHomepage-box-color">
        <div class="box-sidebar">
            <h1 class="box-sidebar--header">
                <i class="fa-solid fa-network-wired"></i> Ispotify Admin
            </h1>
            <ul class="box-sidebar--list">
                <li class="box-sidebar--item">
                    <a href="/admin/" class="box-sidebar--item-link">
                        <i class="fa-solid fa-gauge"></i>
                        Dashboard
                    </a>
                </li>
                <li class="box-sidebar--item">
                    <a href="/admin/users" class="box-sidebar--item-link">
                        <i class="fa-solid fa-user"></i>
                        Users
                    </a>
                </li>
                <li class="box-sidebar--item">
                    <a href="/admin/artists" class="box-sidebar--item-link">
                        <i class="fas fa-microphone-alt"></i>
                        Artists
                    </a>
                </li>
                <li class="box-sidebar--item">
                    <a href="/admin/songs" class="box-sidebar--item-link">
                        <i class="fas fa-music"></i>
                        Music Manager
                    </a>
                </li>
                <li class="box-sidebar--item">
                    <a href="/admin/reports" class="box-sidebar--item-link">
                        <i class="fas fa-file-alt"></i>
                        Reports
                    </a>
                </li>
            </ul>
            <h3 class="box-sidebar-setAccout--header">Account</h3>
            <ul class="box-sidebar--list">
                <li class="box-sidebar--item">
                    <a href="/admin/profile" class="box-sidebar--item-link">
                        Profile
                    </a>
                </li>
                <li class="box-sidebar--item">
                    <a href="/admin/create-admin" class="box-sidebar--item-link">
                        Create new admin
                    </a>
                </li>
                <li class="box-sidebar--item">
                    <form action="/logout" method="POST">
                        <button type="submit" class="box-sidebar--item--button">Logout</button>
                    </form>
                </li>
            </ul>
        </div>
        <div class="box-content">
            <%- body %>
        </div>
    </div>
   
  <!-- Script dùng chung -->
  <script src="/js/AReportpage.js"></script>

</body>

</html>